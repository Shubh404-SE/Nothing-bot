# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional — guild deploy for faster dev iteration
DISCORD_GUILD_ID=

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Feature flags
FEATURE_TRANSLATION_SLASH=true
FEATURE_TRANSLATION_REACTION=true
FEATURE_TRANSLATION_CONTEXT_MENU=true

# Directory used to persist per-user/per-server language preferences (data/preferences.json).
# Point this at a durable/mounted path on whatever host you deploy to; local disk is fine for
# the Windows/PM2 path, but a container host needs a persistent volume/disk mounted here.
DATA_DIR=./data

# Translation limits
TRANSLATION_TIMEOUT_MS=10000
TRANSLATION_MAX_CONCURRENT=5
MAX_TRANSLATION_INPUT_LENGTH=2000
MAX_TRANSLATION_OUTPUT_LENGTH=4000

# Cache TTLs (seconds)
TRANSLATION_DEDUPE_TTL_SEC=300
TRANSLATION_COOLDOWN_TTL_SEC=3
TRANSLATION_SLASH_DEDUPE_TTL_SEC=30
TRANSLATION_SLASH_COOLDOWN_TTL_SEC=5
TRANSLATION_RESULT_CACHE_TTL_SEC=600
CACHE_MAX_ENTRIES=10000
